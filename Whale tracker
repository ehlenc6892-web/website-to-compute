async function fetchSuggested(){
  const r = await fetch('/api/suggested'); const data = await r.json();
  const el = document.getElementById('suggested');
  if (!data.length) { el.innerHTML = '<p>No suggestions yet.</p>'; return; }
  el.innerHTML = data.map(t => `
    <div class="token">
      <div><b>${t.mint.slice(0,8)}...</b> <small>${t.reason}</small></div>
      <div><a href="/token.html?mint=${encodeURIComponent(t.mint)}" target="_blank">Details</a>
      <button onclick="copy('${t.mint}')">Copy CA</button></div>
    </div>
  `).join('');
}

async function fetchWhales(){
  const r = await fetch('/api/whales'); const data = await r.json();
  const el = document.getElementById('whales');
  if (!data.length) { el.innerHTML = '<p>No whale buys yet.</p>'; return; }
  el.innerHTML = data.map(w => `
    <div class="whale">
      <a href="${w.link}" target="_blank">${w.sig.slice(0,8)}...</a>
      <div>mint: ${w.mint.slice(0,8)}... | sol: ${w.sol_value}</div>
    </div>
  `).join('');
}

function copy(text){ navigator.clipboard.writeText(text); }

document.getElementById('add').onclick = async () => {
  const w = document.getElementById('wallet').value.trim();
  if (!w) return alert('Paste wallet');
  await fetch('/api/add_wallet', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({wallet:w})});
  document.getElementById('wallet').value='';
  alert('Added — scanner will pick up soon.');
};

setInterval(fetchSuggested, 5000);
setInterval(fetchWhales, 5000);
fetchSuggested(); fetchWhales();
